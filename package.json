		"zod": "^4.6.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.8",
		"@cloudflare/workers-types": "^5.20260911.1",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.2",
		"@types/react": "~19.2.0",
		"@types/react-dom": "~19.2.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.70.0",
