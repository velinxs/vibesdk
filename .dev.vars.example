# Copy to .dev.vars for local development. Nothing here reaches the browser.

# Provider for the evaluator and actor: workers-ai | demo
# workers-ai uses the AI binding (Nemotron on Workers AI). Locally it needs `wrangler login`
# because the AI binding runs remotely. demo is an authored fallback with no live model;
# the HUD labels it as such.
AI_PROVIDER=demo
